---
import { projects } from '../data/content';
---

<section id="projects" class="section relative">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <p class="text-indigo-400 font-medium mb-2">Portfolio</p>
      <h2 class="section-title">Projetos em Destaque</h2>
      <p class="section-subtitle mx-auto">
        Alguns dos projetos que desenvolvi e que representam meu trabalho.
      </p>
    </div>

    <!-- Featured Projects -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      {projects.filter(p => p.featured).map((project) => (
        <div class="group relative rounded-2xl overflow-hidden glass hover:bg-slate-800/50 transition-all duration-500 card-hover">
          <!-- In Development Badge -->
          {project.inDevelopment && (
            <div class="absolute top-4 left-4 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 backdrop-blur-sm border border-amber-500/30">
              <svg class="w-4 h-4 text-amber-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
              </svg>
              <span class="text-xs font-medium text-amber-400">Em Desenvolvimento</span>
            </div>
          )}
          
          <!-- Project Image Placeholder -->
          <div class="aspect-video bg-gradient-to-br from-indigo-500/20 via-purple-500/10 to-slate-900 relative overflow-hidden">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(99,102,241,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(99,102,241,0.05)_1px,transparent_1px)] bg-[size:20px_20px]"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-6xl font-bold gradient-text opacity-20 group-hover:opacity-40 transition-opacity">
                {project.title.split(' ').map(w => w[0]).join('')}
              </div>
            </div>
            
            <!-- Overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
            
            <!-- Links overlay -->
            <div class="absolute inset-0 flex items-center justify-center gap-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              {project.github !== '#' && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" 
                   class="p-3 rounded-xl bg-slate-900/80 backdrop-blur hover:bg-indigo-500 transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
              )}
              {project.demo !== '#' && (
                <a href={project.demo} target="_blank" rel="noopener noreferrer"
                   class="p-3 rounded-xl bg-slate-900/80 backdrop-blur hover:bg-indigo-500 transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-white mb-2 group-hover:gradient-text transition-all">
              {project.title}
            </h3>
            <p class="text-slate-400 text-sm mb-4 line-clamp-2">
              {project.description}
            </p>
            
            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Other Projects -->
    {projects.filter(p => !p.featured).length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.filter(p => !p.featured).map((project) => (
          <div class="group p-6 rounded-xl glass hover:bg-slate-800/50 transition-all duration-300 card-hover">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 rounded-lg bg-gradient-to-br from-indigo-500/20 to-purple-500/20">
                <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                </svg>
              </div>
              <div class="flex-1"></div>
              {project.github !== '#' && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
              )}
            </div>
            
            <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-indigo-400 transition-colors">
              {project.title}
            </h3>
            <p class="text-slate-400 text-sm mb-4 line-clamp-2">
              {project.description}
            </p>
            
            <div class="flex flex-wrap gap-2">
              {project.tags.slice(0, 3).map((tag) => (
                <span class="text-xs text-slate-500">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="https://github.com/mateusedua" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Ver mais no GitHub
      </a>
    </div>
  </div>
</section>
