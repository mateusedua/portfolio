const categories = [
  { name: "Frontend", key: "frontend", color: "from-pink-500 to-rose-500" },
  { name: "Backend", key: "backend", color: "from-indigo-500 to-purple-500" },
  { name: "DevOps", key: "devops", color: "from-cyan-500 to-blue-500" },
  { name: "Observabilidade", key: "observability", color: "from-green-500 to-emerald-500" },
];
---

<section id="skills" class="section relative">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/2 left-1/4 w-96 h-96 bg-indigo-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <p class="text-indigo-400 font-medium mb-2">Expertise</p>
      <h2 class="section-title">Habilidades Técnicas</h2>
      <p class="section-subtitle mx-auto">
        Tecnologias e ferramentas que utilizo para construir soluções robustas e escaláveis.
      </p>
    </div>

    <div class="space-y-12">
      {categories.map((category) => (
        <div>
          <h3 class={`text-xl font-semibold mb-6 bg-gradient-to-r ${category.color} bg-clip-text text-transparent`}>
            {category.name}
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            {skills[category.key as keyof typeof skills].map((skill) => (
              <div class="group p-4 rounded-xl glass hover:bg-slate-800/80 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-indigo-500/10">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-slate-700 to-slate-800 p-2 group-hover:from-indigo-500/20 group-hover:to-purple-500/20 transition-all duration-300">
                    <div class="w-full h-full text-slate-400 group-hover:text-indigo-400 transition-colors" set:html={skillIcons[skill.icon] || skillIcons.api} />
                  </div>
                  <span class="font-medium text-slate-300 group-hover:text-white transition-colors">
                    {skill.name}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
