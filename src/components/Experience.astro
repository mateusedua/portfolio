---
import { experience } from '../data/content';
---

<section id="experience" class="section relative">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-indigo-400 font-medium mb-2">Trajetória</p>
      <h2 class="section-title">Experiência Profissional</h2>
      <p class="section-subtitle mx-auto">
        Minha jornada construindo soluções que fazem a diferença.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-indigo-500 via-purple-500 to-cyan-500 transform md:-translate-x-1/2"></div>

      {experience.map((exp, index) => (
        <div class="relative mb-12 last:mb-0">
          <!-- Timeline dot -->
          <div class="absolute left-0 md:left-1/2 w-4 h-4 bg-indigo-500 rounded-full border-4 border-slate-950 transform -translate-x-1/2 z-10 glow"></div>

          <!-- Content card -->
          <div class={`ml-8 md:ml-0 ${index % 2 === 0 ? 'md:mr-[50%] md:pr-12' : 'md:ml-[50%] md:pl-12'}`}>
            <div class="glass rounded-2xl p-6 hover:bg-slate-800/50 transition-all duration-300 card-hover">
              <!-- Header -->
              <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="px-3 py-1 rounded-full text-sm font-medium bg-gradient-to-r from-indigo-500/20 to-purple-500/20 text-indigo-300 border border-indigo-500/30">
                  {exp.period}
                </span>
              </div>

              <h3 class="text-xl font-bold text-white mb-1">{exp.title}</h3>
              <p class="text-indigo-400 font-medium mb-4">{exp.company}</p>
              <p class="text-slate-400 mb-6">{exp.description}</p>

              <!-- Achievements -->
              <div class="space-y-3">
                {exp.achievements.map((achievement) => (
                  <div class="flex items-start gap-3 group">
                    <div class="flex-shrink-0 w-14 text-right">
                      <span class="text-lg font-bold gradient-text">{achievement.metric}</span>
                      <p class="text-xs text-slate-500">{achievement.metricLabel}</p>
                    </div>
                    <div class="w-px h-full bg-slate-700"></div>
                    <p class="text-slate-300 text-sm flex-1 group-hover:text-white transition-colors">
                      {achievement.text}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
